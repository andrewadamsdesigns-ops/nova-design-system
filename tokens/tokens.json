{
  "$description": "Nova design tokens. One source of truth: scripts/build-tokens.mjs turns this file into src/styles/tokens.css. Base tokens are shared by every theme; semantic tokens change per theme.",
  "base": {
    "space": { "0": "0px", "1": "2px", "2": "4px", "3": "8px", "4": "12px", "5": "16px", "6": "20px", "7": "24px", "8": "32px", "9": "40px", "10": "48px", "11": "64px" },
    "radius": { "xs": "4px", "sm": "8px", "md": "12px", "lg": "20px", "xl": "28px", "full": "999px" },
    "font": {
      "sans": "'IBM Plex Sans', system-ui, sans-serif",
      "mono": "'IBM Plex Mono', ui-monospace, monospace",
      "display": "'Krona One', 'IBM Plex Sans', sans-serif"
    },
    "size": { "label": "11px", "xs": "12px", "sm": "14px", "md": "16px", "lg": "20px", "xl": "24px", "2xl": "32px", "3xl": "48px" },
    "weight": { "regular": "400", "medium": "500", "semibold": "600" },
    "tracking": { "label": "0.14em", "wordmark": "0.22em", "tight": "-0.01em" },
    "duration": { "fast": "120ms", "base": "200ms", "slow": "320ms" },
    "ease": { "standard": "cubic-bezier(0.2, 0.8, 0.2, 1)" },
    "control": { "sm": "32px", "md": "40px", "lg": "48px", "key": "64px" },
    "width": { "sm": "32rem", "md": "40rem", "lg": "64rem" }
  },
  "themes": {
